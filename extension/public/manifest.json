{
  "manifest_version": 3,
  "name": "ytclip – YouTube Clip Queue",
  "short_name": "ytclip",
  "version": "0.1.0",
  "description": "Mark clips on YouTube videos and queue them for local download, trimming and smart cropping with the ytclip CLI.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Queue a clip with ytclip",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "index.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"]
}
